# Required
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=      # any long random string; paste the same one into Zernio's webhook settings
ANTHROPIC_API_KEY=

# Safety switches
ONLY_USERNAME=              # test mode: bot only answers this Instagram username. Clear it to go live.
PAUSED=                     # set to 1 to stop the bot instantly

# Optional
COMMENT_KEYWORD=            # e.g. GUIDE. Commenting it on a post triggers a DM.
COMMENT_OPENER=             # the first DM sent to people who comment the keyword
REPLY_DELAY_SECONDS=15      # waits for people to finish typing before answering
MODEL=claude-opus-5-5
